+// M39 instrumentation (logging only; no behaviour change). Writes one line per call to the file named by the
+// environment variable M39_SERVO_LOG (if unset, nothing is written). Times: CLOCK_REALTIME and CLOCK_MONOTONIC ns.
+#pragma once
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <mutex>
+namespace moveit_servo
+{
+inline void m39Log(const char* kind, const char* fmt, ...)
+{
+  static std::mutex mtx;
+  static FILE* f = nullptr;
+  static bool tried = false;
+  std::lock_guard<std::mutex> lock(mtx);
+  if (!tried)
+  {
+    tried = true;
+    const char* path = std::getenv("M39_SERVO_LOG");
+    if (path)
+      f = std::fopen(path, "a");
+  }
+  if (!f)
+    return;
+  timespec rt, mt;
+  clock_gettime(CLOCK_REALTIME, &rt);
+  clock_gettime(CLOCK_MONOTONIC, &mt);
+  std::fprintf(f, "{\"k\":\"%s\",\"wall_ns\":%lld,\"mono_ns\":%lld,", kind,
+               static_cast<long long>(rt.tv_sec) * 1000000000LL + rt.tv_nsec,
+               static_cast<long long>(mt.tv_sec) * 1000000000LL + mt.tv_nsec);
+  va_list ap;
+  va_start(ap, fmt);
+  std::vfprintf(f, fmt, ap);
+  va_end(ap);
+  std::fprintf(f, "}\n");
+  std::fflush(f);
+}
+}  // namespace moveit_servo
