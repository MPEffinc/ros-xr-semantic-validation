+void ControlLeaseManager::b1_on_lease_ended_locked(
+  const std::string & robot_name,
+  const std::string & reason)
+{
+  // B1(b): lease end triggers HORUS's own cancel path for that robot.
+  auto topic_it = b1_cancel_topic_by_robot_.find(robot_name);
+  if (node_ == nullptr || topic_it == b1_cancel_topic_by_robot_.end() || topic_it->second.empty()) {
+    return;
+  }
+  auto & pub = b1_cancel_publishers_[robot_name];
+  if (!pub) {
+    pub = node_->create_publisher<std_msgs::msg::String>(topic_it->second, 10);
+  }
+  std_msgs::msg::String msg;
+  msg.data = "cancel";
+  pub->publish(msg);
+  RCLCPP_INFO(node_->get_logger(), "%s lease_end_cancel robot=%s reason=%s",
+    kB1Marker, robot_name.c_str(), reason.c_str());
+}
