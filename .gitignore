# --- Secrets / credentials: never commit ---
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
*credentials*
*.secret
.env
.env.*

# --- Vendored/pinned upstream clones ---
# These are full git checkouts of third-party repositories pinned to the
# exact commit hashes already documented in semantic_validation/results/
# (EVIDENCE_LEDGER.md and the per-stack result docs). They are reproducible
# via the documented `<repo-url>@<commit>` and are not tracked here to avoid
# committing nested .git directories, third-party history, and large vendored
# binaries (Unity packages, model assets, git pack files).
frameworks/
# V2 framework work products are authored metadata and source-audit records, not vendored
# upstream source. Keep the former versioned while an optional per-framework `upstream/`
# checkout remains ignored.
!semantic_validation/frameworks/
!semantic_validation/frameworks/*/
!semantic_validation/frameworks/*/*.md
!semantic_validation/frameworks/*/manifest.yaml
!semantic_validation/frameworks/*/PINNED_REVISION
semantic_validation/frameworks/*/upstream/
semantic_validation/targets/
# ROS-TCP Endpoint is an optional upstream checkout in the isolated ROS
# workspace.  Its exact origin/revision is recorded in framework metadata.
ros_env/ros2_ws/src/ros_tcp_endpoint/

# --- Large raw hardware-capture logs ---
# semantic_validation/logs/quest_hw/ contains the raw canonical Quest 3
# hardware-run JSONL captures (~307MB total; one file exceeds GitHub's
# 100MB per-file limit). These stay local only. Every canonical result
# document that cites them (SPES_QUEST_HW_RESULT.md, SPES_HW_REANALYSIS.md,
# EVIDENCE_LEDGER.md) references their path for local reproduction; do not
# re-scope this rule to other semantic_validation/logs/ subdirectories
# without checking size first.
semantic_validation/logs/quest_hw/
# A failed, root-owned first attempt is intentionally retained locally for
# forensics but is not a canonical result.
semantic_validation/logs/spes_ros_pi_20260907T041500Z/
# Intermediate automation diagnostics are retained locally but are not the
# canonical final run.  The final 20260907T043540Z evidence remains tracked.
semantic_validation/logs/questless_all_20260907T042910Z/
semantic_validation/logs/questless_all_20260907T042941Z/
semantic_validation/logs/questless_all_20260907T043157Z/
semantic_validation/logs/questless_all_20260907T043234Z/
semantic_validation/logs/questless_all_20260907T043318Z/
semantic_validation/logs/questless_all_20260907T043433Z/
semantic_validation/logs/spes_questless_all_20260907T043157Z/
semantic_validation/logs/spes_questless_all_20260907T043234Z/
semantic_validation/logs/spes_questless_all_20260907T043318Z/
semantic_validation/logs/spes_questless_all_20260907T043433Z/

