# Root .gitignore for the authority_continuity workspace.
# The archived project keeps its original rules in Deprecated/.gitignore
# (git applies them relative to Deprecated/, so archived ignore semantics are unchanged).

# --- Secrets / credentials: never commit (public repository) ---
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
*credentials*
*secret*
*token*
!**/*token*.md
.env
.env.*
*.kdbx

# --- Third-party upstream checkouts (pinned by SHA in docs, never tracked) ---
authority_continuity/references/upstream/
authority_continuity/references/papers/*.pdf

# --- Large / raw run outputs (keep local; commit summaries + hashes) ---
authority_continuity/results/raw/
*.bag
*.db3
*.mcap

# --- Build artifacts / caches ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
node_modules/
build/
install/
log/
*.egg-info/

# --- Editor / OS / local tool state ---
.DS_Store
*.swp
.agents/
.claude/
.codex/

# --- xr_demo_integrity workspace (added 2026-09-30) ---
xr_demo_integrity/references/upstream/
xr_demo_integrity/references/papers/
xr_demo_integrity/results/raw/
xr_demo_integrity/results/models/
*.hdf5
*.h5
*.pt
*.pth
*.ckpt
*.safetensors
*.mp4
