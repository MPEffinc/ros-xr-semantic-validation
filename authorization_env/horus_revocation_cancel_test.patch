+void ControlLeaseManager::publish_test_cancel_locked(
+  const std::string & robot_name,
+  const std::string & reason)
+{
+  if (node_ == nullptr || robot_name.empty()) {
+    return;
+  }
+
+  auto & publisher = test_cancel_publishers_[robot_name];
+  if (!publisher) {
+    publisher = node_->create_publisher<std_msgs::msg::String>(
+      "/" + robot_name + "/goal_cancel", 10);
+  }
+
+  std_msgs::msg::String message;
+  message.data = "cancel";
+  publisher->publish(message);
+  RCLCPP_WARN(
+    node_->get_logger(),
+    "TEST-ONLY lease revocation cancel published for robot '%s' (%s)",
+    robot_name.c_str(),
+    reason.c_str());
+}
