<?xml version="1.0" encoding="UTF-8"?>
<policy version="0.2.0">
  <enclaves>
    <enclave path="/robot">
      <profiles>
        <profile ns="/" node="dummy_robot">
          <topics publish="ALLOW">
            <topic>/parameter_events</topic>
          </topics>
          <topics subscribe="ALLOW">
            <topic>/cmd_vel</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <enclave path="/authorized">
      <profiles>
        <profile ns="/" node="direct_publisher">
          <topics publish="ALLOW">
            <topic>/cmd_vel</topic>
            <topic>/q2r_right_hand_twist</topic>
            <topic>/parameter_events</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <enclave path="/low">
      <profiles>
        <profile ns="/" node="direct_publisher">
          <topics publish="DENY">
            <topic>/cmd_vel</topic>
            <topic>/q2r_right_hand_twist</topic>
          </topics>
          <topics publish="ALLOW">
            <topic>/parameter_events</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <enclave path="/trusted_bridge">
      <profiles>
        <profile ns="/" node="rosbridge_websocket">
          <topics publish="ALLOW">
            <topic>/cmd_vel</topic>
            <topic>/client_count</topic>
            <topic>/connected_clients</topic>
            <topic>/parameter_events</topic>
            <topic>/rosout</topic>
          </topics>
          <topics subscribe="ALLOW">
            <topic>/parameter_events</topic>
          </topics>
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
        </profile>
      </profiles>
    </enclave>

    <enclave path="/dummy_receiver">
      <profiles>
        <profile ns="/" node="quest_dummy_receiver">
          <topics publish="ALLOW">
            <topic>/parameter_events</topic>
            <topic>/rosout</topic>
          </topics>
          <topics subscribe="ALLOW">
            <topic>/q2r_right_hand_twist</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <enclave path="/trusted_quest_bridge">
      <profiles>
        <profile ns="/" node="UnityEndpoint">
          <topics publish="ALLOW">
            <topic>/parameter_events</topic>
            <topic>/rosout</topic>
          </topics>
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
        </profile>
        <profile ns="/" node="q2r_right_hand_twist_RosPublisher">
          <topics publish="ALLOW">
            <topic>/q2r_right_hand_twist</topic>
            <topic>/parameter_events</topic>
            <topic>/rosout</topic>
          </topics>
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
        </profile>
      </profiles>
    </enclave>
  </enclaves>
</policy>
