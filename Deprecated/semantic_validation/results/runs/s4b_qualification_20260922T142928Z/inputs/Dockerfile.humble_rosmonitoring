FROM docker-teleop-humble:local

USER root
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ros-humble-example-interfaces \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m pip install --no-cache-dir \
    PyYAML==6.0.2 \
    pytest==8.3.3 \
    websocket-client==1.8.0 \
    websockets==13.1
